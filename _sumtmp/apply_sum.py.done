cnt=0
for f,fields in S.items():
    p=D+f
    d=json.load(open(p,encoding='utf-8'))
    d.update(fields)
    d['summarized_at']=now
    json.dump(d,open(p,'w',encoding='utf-8'),ensure_ascii=False,indent=2)
    cnt+=1
    print('OK',f)
print('DONE_MYSCRIPT',cnt,now)
